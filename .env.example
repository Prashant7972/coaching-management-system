# Environment Configuration for Coaching Management System
# Copy this file to .env and update the values as needed

SECRET_KEY=django-insecure-coaching-mgmt-sys-secret-key-prod-2026
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (MySQL)
DB_ENGINE=mysql
DB_NAME=coaching_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# If MySQL is not installed locally and you want to use SQLite for quick testing, set:
# USE_SQLITE=1
